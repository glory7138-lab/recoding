[
  {
    "id": 1,
    "start": 4.0,
    "end": 5.5,
    "text": "น้อง มีปืนขายมั้ย",
    "translation": "꼬마야, 총 파니?"
  },
  {
    "id": 2,
    "start": 6.0,
    "end": 9.5,
    "text": "มี จะเอาแบบไหน แบบดีหรือแบบธรรมดา",
    "translation": "있어요. 어떤 걸로 원해요? 좋은 거요, 아니면 평범한 거요?"
  },
  {
    "id": 3,
    "start": 10.0,
    "end": 11.0,
    "text": "เอาอย่างดีมาเลย",
    "translation": "제일 좋은 걸로 줘."
  },
  {
    "id": 4,
    "start": 11.5,
    "end": 13.0,
    "text": "เอาแบบสั้นหรือแบบยาว",
    "translation": "짧은 거요, 긴 거요?"
  },
  {
    "id": 5,
    "start": 13.0,
    "end": 14.0,
    "text": "สั้นก็ได้",
    "translation": "짧은 걸로 줘."
  },
  {
    "id": 6,
    "start": 14.0,
    "end": 16.0,
    "text": "อัดแก๊สหรืออัดลม",
    "translation": "가스건이요, 공기총이요?"
  },
  {
    "id": 7,
    "start": 17.5,
    "end": 18.5,
    "text": "อัดลม",
    "translation": "공기총."
  },
  {
    "id": 8,
    "start": 19.5,
    "end": 21.0,
    "text": "เอาลูกโม่ หรือแมกกาซีน",
    "translation": "리볼버요, 아니면 탄창형이요?"
  },
  {
    "id": 9,
    "start": 21.0,
    "end": 22.0,
    "text": "แมกกาซีน",
    "translation": "탄창형."
  },
  {
    "id": 10,
    "start": 22.5,
    "end": 24.0,
    "text": "ดำด้านหรือดำเงา",
    "translation": "무광 블랙이요, 유광 블랙이요?"
  },
  {
    "id": 11,
    "start": 24.0,
    "end": 25.0,
    "text": "ดำด้าน",
    "translation": "무광 블랙."
  },
  {
    "id": 12,
    "start": 26.0,
    "end": 27.0,
    "text": "รอแป๊บ",
    "translation": "잠깐만요."
  },
  {
    "id": 13,
    "start": 27.5,
    "end": 28.5,
    "text": "เออ",
    "translation": "어."
  },
  {
    "id": 14,
    "start": 37.0,
    "end": 39.0,
    "text": "อืม.. หมด",
    "translation": "음.. 다 떨어졌네요."
  },
  {
    "id": 15,
    "start": 40.0,
    "end": 41.5,
    "text": "อ้าว แล้วเหลือแบบไหนบ้างเนี่ย",
    "translation": "아, 그럼 대체 어떤 게 남았는데?"
  },
  {
    "id": 16,
    "start": 41.5,
    "end": 42.5,
    "text": "หมดทุกแบบ",
    "translation": "전부 다 떨어졌어요."
  },
  {
    "id": 17,
    "start": 42.5,
    "end": 45.5,
    "text": "เอ้า ไอ้เตี้ยเอ๊ย แล้วจะถามอะไรเยอะแยะเนี่ย มันเสียเวลา เข้าใจป่ะ",
    "translation": "어휴, 이 꼬맹아! 그럼 왜 그렇게 많이 물어본 거야? 시간 낭비잖아, 알겠어?"
  },
  {
    "id": 18,
    "start": 46.0,
    "end": 49.0,
    "text": "มี.. มีแต่กุญแจมือ เอา เอาไหม",
    "translation": "수갑밖에 없는데, 가질래요?"
  },
  {
    "id": 19,
    "start": 49.0,
    "end": 50.0,
    "text": "เอามา",
    "translation": "가져와."
  },
  {
    "id": 20,
    "start": 50.0,
    "end": 51.0,
    "text": "เอาแบบเหล็ก...",
    "translation": "철제 수갑으로..."
  },
  {
    "id": 21,
    "start": 51.0,
    "end": 53.5,
    "text": "เหล็กเหลิกอะไร มึงเอามาให้หมดอะ เอามาวางเรียงตรงเนี้ย เดี๋ยวเลือกเอง",
    "translation": "철이든 뭐든 다 가져와. 여기 앞에 쭉 늘어놔 봐, 내가 고를 테니까."
  },
  {
    "id": 22,
    "start": 53.5,
    "end": 55.0,
    "text": "เอาน้ำเปล่ามาด้วย",
    "translation": "생수도 하나 가져오고."
  },
  {
    "id": 23,
    "start": 57.0,
    "end": 58.0,
    "text": "เอา เอาน้ำ...",
    "translation": "무, 무슨 물로..."
  },
  {
    "id": 24,
    "start": 58.0,
    "end": 62.0,
    "text": "น้ำอะไรก็ได้ เปิดตู้เย็นเจอน้ำอะไรเอาออกมา เก็กฮวยเก็กฮวยอะไรเอาออกมา",
    "translation": "무슨 물이든 상관없어! 냉장고 열어서 보이는 거 다 가져와. 국화차든 뭐든 다 가져와!"
  },
  {
    "id": 25,
    "start": 62.0,
    "end": 63.5,
    "text": "ถ้ามันไม่มีเก็กฮวย...",
    "translation": "만약에 국화차가 없으면..."
  },
  {
    "id": 26,
    "start": 63.5,
    "end": 66.0,
    "text": "ก็น้ำอะไรก็ได้ ก็ไปเอามาดิ โว้ย",
    "translation": "아무 물이나 상관없으니까 걍 가져오라고, 아오!"
  }
]